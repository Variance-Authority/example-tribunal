{
  "name": "@variance-authority/example-tribunal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A third-party storefront, read as routes and as stories, reviewed in a tribunal.",
  "scripts": {
    "app:fetch": "node scripts/prepare.mjs",
    "app:build": "npm --prefix app run build && npm --prefix app run build-storybook",
    "app:serve": "npm --prefix app run start:variance",
    "revise": "node scripts/revise.mjs",
    "effect": "node scripts/effect.mjs",
    "handler": "node scripts/handler.mjs",
    "variance": "variance",
    "tribunal": "variance-authority-tribunal",
    "provision": "node deploy/provision.mjs",
    "deploy:assets": "node deploy/assets.mjs",
    "deploy": "npm run deploy:assets && wrangler deploy --config deploy/wrangler.jsonc",
    "deploy:push": "node deploy/push.mjs",
    "push": "variance push"
  },
  "devDependencies": {
    "@variance-authority/cli": "^0.15.0",
    "@variance-authority/route-collector": "^0.15.0",
    "@variance-authority/storybook": "^0.15.0",
    "@variance-authority/storybook-collector": "^0.15.0",
    "@variance-authority/tribunal": "^0.15.0",
    "playwright": "1.64.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wrangler": "^4.128.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true
  }
}
